{
  "name": "adhit-office",
  "version": "0.2.0",
  "private": true,
  "description": "Adhit Office — kantor pixel-art untuk mengoperasikan Claude Code dari browser dan HP",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "open": "node server.js --open",
    "dev": "node --watch server.js",
    "figma-bridge": "node tools/figma-bridge/server.mjs",
    "build:win": "node scripts/build-windows.mjs",
    "test": "node --test --test-concurrency=1",
    "test:claude": "node test-support/claude-contract.mjs",
    "test:opencode": "node test-support/opencode-contract.mjs",
    "lint": "npx --yes eslint@9.39.5 ."
  }
}
