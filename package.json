{
  "name": "adhitron",
  "version": "1.0.26",
  "private": true,
  "description": "Adhitron — kantor pixel-art untuk mengoperasikan Claude Code dari browser dan HP",
  "author": "Adhit",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "open": "node server.js --open",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "figma-bridge": "node tools/figma-bridge/server.mjs",
    "build:win": "node scripts/build-windows.mjs",
    "build:linux": "node scripts/build-linux.mjs",
    "build:mac": "node scripts/build-macos.mjs",
    "build:electron": "electron-builder --win --dir --config desktop/electron-builder.yml",
    "test": "node --test --test-concurrency=1",
    "test:fast": "node test-support/ci-tests.mjs fast",
    "test:smoke": "node test-support/ci-tests.mjs smoke",
    "test:unit": "node test-support/ci-tests.mjs unit",
    "test:ui": "node test-support/ci-tests.mjs ui",
    "test:claude": "node test-support/claude-contract.mjs",
    "test:opencode": "node test-support/opencode-contract.mjs",
    "lint": "npm exec --yes --package=eslint@9.39.5 -- eslint ."
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.12",
    "postject": "^1.0.0-alpha.6"
  }
}
